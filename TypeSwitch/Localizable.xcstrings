    },
    "只说一种格式：%@ 的 %@。任何说这套格式的地址都可以填。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One format: %1$@, over %2$@. Any address that speaks it works here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "只说一种格式：%1$@ 的 %2$@。任何说这套格式的地址都可以填。"
