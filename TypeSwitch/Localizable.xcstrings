      }
    },
    "读不到 %@ 里的文字": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the text in %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读不到 %@ 里的文字"
          }
        }
      }
    },
    "跑在这台机器上的模型通常不要 Key，留空就行。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A model running on this machine usually wants no key at all — leave it blank."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跑在这台机器上的模型通常不要 Key，留空就行。"
          }
        }
      }
    },
    "输出语言": {
