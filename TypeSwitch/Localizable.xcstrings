{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "": {},
    "%@ 失败（%d）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ failed (%2$d)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ 失败（%2$d）"
          }
        }
      }
    },
    "%@ 这个版本没有附完整的安装包": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release %@ does not carry a complete download"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 这个版本没有附完整的安装包"
          }
        }
      }
    },
    "%lld 个": {
      "localizations": {
