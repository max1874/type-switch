            "value": "Use the button and this address will list the models it has."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点右边，让这个地址自己列出它有哪些模型。"
          }
        }
      }
    },
    "焦点已经切走，没有写回": {
