          "stringUnit": {
            "state": "translated",
            "value": "出错：%@"
          }
        }
      }
    },
    "发给模型的原话，其中 %@ 会替换成上面的输出语言。删光等同于用回内置指令。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exact wording sent to the model. %@ is replaced with the output language above. Clear the field to go back to the built-in instructions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发给模型的原话，其中 %@ 会替换成上面的输出语言。删光等同于用回内置指令。"
          }
        }
      }
    },
