        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub returned %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 返回 %lld"
          }
        }
      }
    },
    "Key 不对，或者它没有权限用这个模型：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key is wrong, or it is not allowed to use this model: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Key 不对，或者它没有权限用这个模型：%@"
          }
        }
      }
    },
    "Key 存在你的钥匙串里，只发给上面这个地址。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your key is stored in your keychain and sent only to the address above."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Key 存在你的钥匙串里，只发给上面这个地址。"
          }
        }
      }
    },
    "OpenAI 兼容": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI-compatible"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI 兼容"
          }
        }
      }
    },
    "POST /chat/completions": {},
    "TypeSwitch 设置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TypeSwitch Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TypeSwitch 设置"
          }
        }
      }
    },
    "sk-…": {},
    "writing English 卡住了？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I need to 预约 a meeting tomorrow"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "writing English 卡住了？"
          }
        }
      }
    },
    "下载到的 app 签名和你正在运行的这份不是同一个身份，已经丢掉": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded app is not signed by the same identity as the one you are running, and has been discarded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载到的 app 签名和你正在运行的这份不是同一个身份，已经丢掉"
          }
        }
      }
    },
    "下载的文件和它自己的校验和对不上，已经丢掉": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download does not match its own checksum, and has been discarded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的文件和它自己的校验和对不上，已经丢掉"
          }
        }
      }
    },
    "不再排除这个 app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop excluding this app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不再排除这个 app"
          }
        }
      }
    },
    "不在这些 app 里触发": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never trigger in these apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不在这些 app 里触发"
          }
        }
      }
    },
    "任何说这个格式的地址都可以填。Key 存在你的钥匙串里，只发给上面这个地址；跑在本机的模型通常不需要 Key，留空即可。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any address that speaks this format works here. Your key is stored in your keychain and sent only to the address above; a model running on this machine usually needs no key, so leave it blank."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何说这个格式的地址都可以填。Key 存在你的钥匙串里，只发给上面这个地址；跑在本机的模型通常不需要 Key，留空即可。"
          }
        }
      }
    },
    "修饰键不输入字符，不会在正文里留下痕迹。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A modifier key types nothing, so it leaves no trace in your text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修饰键不输入字符，不会在正文里留下痕迹。"
          }
        }
      }
    },
    "先看看 %@ 改了什么…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what changed in %@…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先看看 %@ 改了什么…"
          }
        }
      }
    },
    "关掉后，再次打开 TypeSwitch 会回到这个窗口。出错时屏幕上会弹一条提示，不依赖这个图标。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With it off, opening TypeSwitch again brings you back to this window. A failure puts a message on screen, so it does not depend on this icon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关掉后，再次打开 TypeSwitch 会回到这个窗口。出错时屏幕上会弹一条提示，不依赖这个图标。"
          }
        }
      }
    },
    "写回失败（AXError %lld）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not write the text back (AXError %lld)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写回失败（AXError %lld）"
          }
        }
      }
    },
    "出错：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Error: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出错：%@"
          }
        }
      }
    },
    "列出这个地址上有哪些模型": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List the models this address has"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出这个地址上有哪些模型"
          }
        }
      }
    },
    "到 %@ 拿 Key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a key from %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到 %@ 拿 Key"
          }
        }
      }
    },
    "发给模型的原话，其中 %@ 会替换成上面的输出语言。删光等同于用回内置指令。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exact wording sent to the model. %@ is replaced with the output language above. Clear the field to go back to the built-in instructions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发给模型的原话，其中 %@ 会替换成上面的输出语言。删光等同于用回内置指令。"
          }
        }
      }
    },
    "取出新版本": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taking the new version out"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取出新版本"
          }
        }
      }
    },
    "取模型列表失败（%lld）：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not list the models (%lld): %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "取模型列表失败（%1$lld）：%2$@"
          }
        }
      }
    },
    "取消": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
