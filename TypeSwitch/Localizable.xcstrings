          }
        }
      }
    },
    "sk-…": {},
    "writing English 卡住了？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I need to 预约 a meeting tomorrow"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "writing English 卡住了？"
          }
        }
      }
    },
    "不再排除这个 app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop excluding this app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不再排除这个 app"
          }
        }
      }
    },
    "不在这些 app 里触发": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never trigger in these apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不在这些 app 里触发"
          }
        }
      }
    },
    "任何兼容 OpenAI 格式的服务都可以填。Key 存在你的钥匙串里，只发给上面这个地址。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything that speaks the OpenAI format works here. Your key is stored in your keychain and sent only to the address above."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何兼容 OpenAI 格式的服务都可以填。Key 存在你的钥匙串里，只发给上面这个地址。"
          }
        }
      }
    },
    "修饰键不输入字符，不会在正文里留下痕迹。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A modifier key types nothing, so it leaves no trace in your text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修饰键不输入字符，不会在正文里留下痕迹。"
          }
        }
      }
    },
    "关掉后，再次打开 TypeSwitch 会回到这个窗口。出错时图标会自己回来，否则你不会知道它失败了。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With it off, opening TypeSwitch again brings you back to this window. The icon comes back on its own when something goes wrong — otherwise a failure would look like nothing happening."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关掉后，再次打开 TypeSwitch 会回到这个窗口。出错时图标会自己回来，否则你不会知道它失败了。"
          }
        }
      }
    },
    "写回失败（AXError %lld）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not write the text back (AXError %lld)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写回失败（AXError %lld）"
