    "触发": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trigger"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触发"
          }
        }
      }
    },
    "触发键": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trigger key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触发键"
          }
        }
      }
    },
    "触发键认的是按键，不是按键底下是什么。终端和代码编辑器里读到的一行，很可能是提示符或一行代码而不是正文。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trigger recognises a keystroke, not what sits under it. In a terminal or an editor, the line it picks up is as likely to be a prompt or a line of code as it is prose."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触发键认的是按键，不是按键底下是什么。终端和代码编辑器里读到的一行，很可能是提示符或一行代码而不是正文。"
          }
        }
      }
    },
    "设置…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置…"
          }
        }
      }
    },
    "试一句「%@」": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try “%@”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试一句「%@」"
          }
        }
      }
    },
    "请求太密，等一会儿再试：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests too quickly. Try again in a moment: %@"
          }
        },
